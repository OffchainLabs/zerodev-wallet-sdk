NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARB_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ANVIL_URL=

# One project per email delivery method — the SDK falls back to OTP when a
# single project has both configured, so magic link never fires.
NEXT_PUBLIC_ZD_PROJECT_ID=
NEXT_PUBLIC_ZD_OTP_PROJECT_ID=

# Surfaced by the /environment page. KMS_PROXY_BASE_URL is required by
# wagmi-config; ZERODEV_AA_HOST is an optional override.
NEXT_PUBLIC_KMS_PROXY_BASE_URL=
NEXT_PUBLIC_ZERODEV_AA_HOST=
