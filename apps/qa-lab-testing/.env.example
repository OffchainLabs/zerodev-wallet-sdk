NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opt in to the in-app mock layer: patches fetch and shows a scenario picker in
# the header. Presets are shared with the Playwright suite (e2e/mocks/presets).
# Inlined at build time, so changing it needs a dev-server restart. Leave unset
# for normal use — unset means fetch is never touched.
NEXT_PUBLIC_ENABLE_MOCKS=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARB_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ZERODEV_PROJECT_ID=

# Surfaced by the /environment page. KMS_PROXY_BASE_URL is required by
# wagmi-config; ZERODEV_AA_HOST is an optional override.
NEXT_PUBLIC_KMS_PROXY_BASE_URL=
NEXT_PUBLIC_ZERODEV_AA_HOST=
