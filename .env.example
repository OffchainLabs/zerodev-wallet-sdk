# E2E Test Environment Variables
# Copy this file to .env and fill in the values

# Magic-link-configured project ID
ZD_PROJECT_ID=

# Plain-OTP project ID (no magic_link_template)
ZD_OTP_PROJECT_ID=

# Wallet-extension browser e2e
WALLET_SRP=
# Local to that cached profile only. Must satisfy the wallet's password rules.
WALLET_PASSWORD=
